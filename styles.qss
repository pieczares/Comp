QWidget {
    font-family: "Segoe UI", Arial;
    font-size: 14px;
    color: #17243b;
}

#PageTitle {
    font-size: 26px;
    font-weight: 700;
}

#Tile {
    background-color: #f4f6fb;
    border: 1px solid #d8dfeb;
    border-radius: 14px;
}

#Tile:hover {
    background-color: #e6ecf7;
    border-color: #9db4d8;
}

#TileTitle {
    font-size: 18px;
    font-weight: 700;
}

#TileSubtitle {
    color: #5b6779;
}

QPushButton {
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid #c9d3e3;
    background-color: white;
}

QPushButton:hover {
    background-color: #eef3fb;
}


#ProductCard {
    background-color: white;
    border: 1px solid #d8dfeb;
    border-radius: 12px;
}

#ProductCard:hover {
    border-color: #9db4d8;
    background-color: #f7faff;
}

#ProductName {
    font-size: 16px;
    font-weight: 600;
}

#ProductPrice {
    font-size: 14px;
    color: #334155;
}