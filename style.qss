#FavoriteButton {
    border: none;
    background: transparent;
    padding: 0;
    font-size: 30px;
    color: #e0245e;
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
}

#ErrorLabel {
    color: #ff6b6b;
    font-weight: bold;
}

#QuantityButton {
    height: 16px;
    width: 16px;
    font-size: 14px;
}

#ProductPlaceholder {
    background-color: white;
    border: 1px solid #d8dfeb;
    border-radius: 12px;
}

#PlaceholderBar {
    background-color: #e3e8f0;
    border: none;
    border-radius: 6px;
}
